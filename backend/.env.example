NODE_ENV=development
PORT=3000
API_PREFIX=api/v1
WEB_ORIGIN=*
API_PORT=3000
JWT_ACCESS_SECRET=replace-with-a-unique-random-secret-at-least-32-characters
JWT_REFRESH_DAYS=30
CARD_HMAC_SECRET=replace-with-a-different-unique-random-secret-at-least-32-characters
NIK_HMAC_SECRET=replace-with-another-different-unique-random-secret-at-least-32-characters
MACHINE_API_KEY=replace-with-a-unique-machine-only-secret
MYSQL_ROOT_PASSWORD=replace-with-a-unique-mysql-root-password
DB_HOST=mysql
DB_PORT=3306
DB_USERNAME=smartbin
DB_PASSWORD=replace-with-a-unique-database-password
DB_DATABASE=smartbin
DB_SYNCHRONIZE=true
LOGIN_MAX_ATTEMPTS=5
MONGO_USERNAME=smartbin
MONGO_PASSWORD=replace-with-a-unique-mongodb-password
MONGO_DATABASE=smartbin_realtime
MONGO_PORT=27017
MONGO_TELEMETRY_TTL_SECONDS=7776000
MQTT_URL=wss://mqtt-smartbin.ramadhanjp.my.id:443/mqtt
MQTT_CLIENT_ID=smartbin-api
MQTT_USERNAME=smartbin_backend
MQTT_PASSWORD=replace-with-your-backend-mqtt-password
MQTT_SUBSCRIBE_TOPIC=smartbin/+/telemetry/#
MQTT_DEVICE_MACHINE_MAP=esp1=bin-01,esp2=bin-02
CAPTURE_STORAGE_DIR=/var/lib/smartbin/captures
