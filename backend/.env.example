NODE_ENV=development
PORT=3000
API_PREFIX=api/v1
WEB_ORIGIN=*
JWT_ACCESS_SECRET=replace-with-a-long-random-secret
JWT_REFRESH_DAYS=30
CARD_HMAC_SECRET=replace-with-a-different-long-random-secret
NIK_HMAC_SECRET=replace-with-another-different-long-random-secret
MACHINE_API_KEY=replace-with-a-machine-only-secret
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USERNAME=smartbin
DB_PASSWORD=smartbin
DB_DATABASE=smartbin
DB_SYNCHRONIZE=true
LOGIN_MAX_ATTEMPTS=5
